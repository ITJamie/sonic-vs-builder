Subject: [202605] [accton] Add read-only BIOS inventory to AS7326 and AS7726

Backported from ITJamie/sonic-buildimage accton-fixes commit e58a14a1d5b5e3f121cec85454b08ce9aed2c6e0.
Verified target source: 5ef9e45ccf7f004fb07bf3f9be2f471cf00573bf.
Includes prerequisite changes to these files from earlier platform patches.
Keep each final file in one patch so apply/reapply checks remain reliable.
Preserve 202605 conversion syntax, dependency pins and original fan policy.
Upstream PR: https://github.com/sonic-net/sonic-buildimage/pull/30780
Remove when the target branch supplies equivalent fixes.

diff --git a/platform/broadcom/sonic-platform-modules-accton/as7326-56x/sonic_platform/component.py b/platform/broadcom/sonic-platform-modules-accton/as7326-56x/sonic_platform/component.py
new file mode 100644
index 0000000..bfdb548
--- /dev/null
+++ b/platform/broadcom/sonic-platform-modules-accton/as7326-56x/sonic_platform/component.py
@@ -0,0 +1,17 @@
+"""Read-only firmware inventory using the standard PDDF component API."""
+
+from sonic_platform_pddf_base.pddf_component import PddfComponent
+
+
+class Component(PddfComponent):
+    def get_presence(self):
+        return True
+
+    def get_status(self):
+        return self.get_firmware_version() not in ('', 'Unknown')
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    def is_replaceable(self):
+        return False
diff --git a/platform/broadcom/sonic-platform-modules-accton/as7726-32x/sonic_platform/component.py b/platform/broadcom/sonic-platform-modules-accton/as7726-32x/sonic_platform/component.py
